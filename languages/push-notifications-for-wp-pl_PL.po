#: includes/class-settings-page.php:370
#: includes/class-settings-page.php:407
msgid "Recipient"
msgstr "Odbiorca"

#: includes/class-settings-page.php:379
msgid "Send a test notification"
msgstr "Wyślij powiadomienie próbne"

#: includes/class-settings-page.php:382
msgid "Sends one notification marked as a test. It is not recorded as a site event."
msgstr "Wysyła jedno powiadomienie oznaczone jako próbne. Nie jest liczone jako zdarzenie witryny."

#: includes/class-settings-page.php:396
msgid "Recent deliveries"
msgstr "Ostatnie wysyłki"

#: includes/class-settings-page.php:398
msgid "Nothing has been sent yet."
msgstr "Nic jeszcze nie zostało wysłane."

#: includes/class-settings-page.php:405
msgid "When"
msgstr "Kiedy"

#: includes/class-settings-page.php:408
msgid "Result"
msgstr "Wynik"

#: includes/class-settings-page.php:409
msgid "Details"
msgstr "Szczegóły"

#: includes/class-settings-page.php:434
msgid "You are not allowed to send notifications from this site."
msgstr "Nie masz uprawnień do wysyłania powiadomień z tej witryny."

#: includes/class-settings-page.php:445
msgid "No application token is set, so there is nothing to send with."
msgstr "Nie ustawiono klucza aplikacji, więc nie ma czym wysłać."

#: includes/class-settings-page.php:453
msgid "That account cannot receive notifications: it either has no Pushover key or is not allowed to edit content."
msgstr "To konto nie może odbierać powiadomień: nie ma klucza Pushover albo nie może edytować treści."

#: includes/class-settings-page.php:463
msgid "Delivered. The phone should have it."
msgstr "Doręczono. Powiadomienie powinno już być na telefonie."

#. translators: %s: reason returned by Pushover
#: includes/class-settings-page.php:474
#, php-format
msgid "Pushover refused the recipient key: %s. Correct it on that person profile."
msgstr "Pushover odrzucił klucz odbiorcy: %s. Popraw go na profilu tej osoby."

#. translators: %s: reason returned by Pushover
#: includes/class-settings-page.php:485
#, php-format
msgid "Pushover refused the request: %s. Check the application token."
msgstr "Pushover odrzucił żądanie: %s. Sprawdź klucz aplikacji."

#. translators: 1: event key, 2: reason returned by Pushover
#: includes/class-settings-page.php:557
#, php-format
msgid "Push notifications are not being delivered. The last failure was on %1$s: %2$s"
msgstr "Powiadomienia push nie są doręczane. Ostatnie niepowodzenie dotyczyło %1$s: %2$s"

#: includes/class-settings-page.php:563
msgid "Open the notification settings"
msgstr "Otwórz ustawienia powiadomień"

