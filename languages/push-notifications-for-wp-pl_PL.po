#: includes/class-settings-page.php:44
#: includes/class-settings-page.php:131
msgid "Push notifications"
msgstr "Powiadomienia push"

#: includes/class-profile-fields.php:48
msgid "Pushover user key"
msgstr "Klucz użytkownika Pushover"

#: includes/class-profile-fields.php:56
msgid "Install the Pushover app, open it and copy the user key shown on its main screen. Leave empty to stop being a possible recipient."
msgstr "Zainstaluj aplikację Pushover, otwórz ją i skopiuj klucz użytkownika z jej ekranu głównego. Puste pole oznacza rezygnację z odbierania powiadomień."

#. translators: %s: reason returned by Pushover
#: includes/class-profile-fields.php:67
#, php-format
msgid "Pushover rejected this key: %s"
msgstr "Pushover odrzucił ten klucz: %s"

#: includes/class-profile-fields.php:76
msgid "Delivery"
msgstr "Doręczanie"

#: includes/class-profile-fields.php:81
msgid "Do not send me notifications"
msgstr "Nie wysyłaj mi powiadomień"

#: includes/class-profile-fields.php:85
msgid "Silences every notification for this account without touching the assignments made in the site settings. Useful while away."
msgstr "Wycisza wszystkie powiadomienia dla tego konta, nie ruszając przypisań z ustawień witryny. Przydaje się na czas nieobecności."

#. translators: %d: HTTP status code
