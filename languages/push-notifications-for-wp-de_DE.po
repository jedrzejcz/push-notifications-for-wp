#. Plugin Name of the plugin
#: push-notifications-for-wp.php
msgid "Push Notifications for WP"
msgstr ""

#. Plugin URI of the plugin
#: push-notifications-for-wp.php
msgid "https://github.com/jedrzejcz/push-notifications-for-wp"
msgstr ""

#. Description of the plugin
#: push-notifications-for-wp.php
msgid "Sends events from your site to the phones of the people who run it, one row per event and one column per person. Delivered through Pushover."
msgstr "Sendet Ereignisse deiner Website an die Telefone der Menschen, die sie betreiben: eine Zeile pro Ereignis, eine Spalte pro Person. Zugestellt über Pushover."

#. Author of the plugin
#: push-notifications-for-wp.php
msgid "Jędrzej Czerwiński"
msgstr ""

#. Author URI of the plugin
#: push-notifications-for-wp.php
msgid "https://github.com/jedrzejcz"
msgstr ""

