#. Plugin Name of the plugin
#: push-notifications-for-wp.php
msgid "Push Notifications for WP"
msgstr ""

#. Plugin URI of the plugin
#: push-notifications-for-wp.php
msgid "https://github.com/jedrzejcz/push-notifications-for-wp"
msgstr ""

#. Description of the plugin
#: push-notifications-for-wp.php
msgid "Sends events from your site to the phones of the people who run it, one row per event and one column per person. Delivered through Pushover."
msgstr "Envía los eventos de tu sitio a los teléfonos de las personas que lo gestionan: una fila por evento y una columna por persona. Se entrega mediante Pushover."

#. Author of the plugin
#: push-notifications-for-wp.php
msgid "Jędrzej Czerwiński"
msgstr ""

#. Author URI of the plugin
