#: includes/class-settings-page.php:434
msgid "You are not allowed to send notifications from this site."
msgstr "No tienes permiso para enviar notificaciones desde este sitio."

#: includes/class-settings-page.php:445
msgid "No application token is set, so there is nothing to send with."
msgstr "No hay ningún token de aplicación definido, así que no hay con qué enviar."

#: includes/class-settings-page.php:453
msgid "That account cannot receive notifications: it either has no Pushover key or is not allowed to edit content."
msgstr "Esa cuenta no puede recibir notificaciones: o no tiene clave de Pushover o no puede editar contenido."

#: includes/class-settings-page.php:463
msgid "Delivered. The phone should have it."
msgstr "Entregada. El teléfono ya debería tenerla."

#. translators: %s: reason returned by Pushover
#: includes/class-settings-page.php:474
#, php-format
msgid "Pushover refused the recipient key: %s. Correct it on that person profile."
msgstr "Pushover ha rechazado la clave del destinatario: %s. Corrígela en el perfil de esa persona."

#. translators: %s: reason returned by Pushover
#: includes/class-settings-page.php:485
#, php-format
msgid "Pushover refused the request: %s. Check the application token."
msgstr "Pushover ha rechazado la petición: %s. Comprueba el token de aplicación."

#. translators: 1: event key, 2: reason returned by Pushover
#: includes/class-settings-page.php:557
#, php-format
msgid "Push notifications are not being delivered. The last failure was on %1$s: %2$s"
msgstr "Las notificaciones push no se están entregando. El último fallo fue en %1$s: %2$s"

#: includes/class-settings-page.php:563
msgid "Open the notification settings"
msgstr "Abrir los ajustes de notificaciones"

