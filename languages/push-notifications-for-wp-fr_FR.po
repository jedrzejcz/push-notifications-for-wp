#. Plugin Name of the plugin
#: push-notifications-for-wp.php
msgid "Push Notifications for WP"
msgstr ""

#. Plugin URI of the plugin
#: push-notifications-for-wp.php
msgid "https://github.com/jedrzejcz/push-notifications-for-wp"
msgstr ""

#. Description of the plugin
#: push-notifications-for-wp.php
msgid "Sends events from your site to the phones of the people who run it, one row per event and one column per person. Delivered through Pushover."
msgstr "Envoie les événements de votre site sur les téléphones des personnes qui le gèrent : une ligne par événement, une colonne par personne. Distribué via Pushover."

#. Author of the plugin
#: push-notifications-for-wp.php
msgid "Jędrzej Czerwiński"
msgstr ""

